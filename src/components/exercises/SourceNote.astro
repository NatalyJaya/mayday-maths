---
// Atribución de un ejercicio: de dónde sale y con qué licencia.
import { getEntry } from 'astro:content';
import Icon from '../ui/Icon.astro';
import type { Exercise } from '../../lib/schemas';
import { withBase } from '../../lib/url';

interface Props {
	ex: Exercise;
}
const { ex } = Astro.props;
const src = ex.fuente ? await getEntry('fuentes', ex.fuente) : undefined;
const inspired = (await Promise.all(ex.inspirado_en.map((id) => getEntry('fuentes', id)))).filter(Boolean);
---

<aside class="source">
	<Icon name="quote" size={16} />
	<div>
		{
			ex.procedencia === 'clase' && (
				<p>
					<strong>Exercici de classe.</strong> {ex.referencia && <>Als teus apunts: {ex.referencia}. </>}{ex.nota_fuente ?? 'Exercici dels apunts de classe.'}
				</p>
			)
		}
		{
			ex.procedencia === 'externo' && src && (
				<p>
					<strong>Adaptat de:</strong>{' '}
					{src.data.url ? <a href={src.data.url} rel="noopener">{src.data.titulo}</a> : src.data.titulo}, de {src.data.autor}.
					Llicència{' '}
					{src.data.licencia_url ? <a href={src.data.licencia_url} rel="license noopener">{src.data.licencia}</a> : src.data.licencia}.
					{ex.nota_fuente && <> {ex.nota_fuente}</>}
				</p>
			)
		}
		{
			ex.procedencia === 'original' && (
				<p>
					<strong>Exercici original</strong>{ex.nota_fuente ? <>. {ex.nota_fuente}</> : ' creat per a aquesta plataforma.'}
					{inspired.length > 0 && (
						<>
							{' '}
							Segueix un tipus de problema habitual a 1r de Batxillerat (vegeu{' '}
							{inspired.map((s, i) => (
								<>
									{i > 0 && ', '}
									<a href={withBase('/fuentes/#referencias')}>{s!.data.autor}</a>
								</>
							))}
							); l’enunciat i les dades són nous.
						</>
					)}
				</p>
			)
		}
	</div>
</aside>

<style>
	.source {
		display: flex;
		gap: 0.6rem;
		align-items: flex-start;
		margin-top: 2rem;
		padding: 0.75rem 0.9rem;
		border-radius: var(--radius-sm);
		background: var(--surface-2);
		color: var(--ink-2);
		font-size: 0.88rem;
	}
	.source :global(.icon) {
		flex: none;
		margin-top: 0.2rem;
		color: var(--ink-3);
	}
	p {
		margin: 0;
	}
</style>
