---
// El caso ambiguo del teorema del seno, con la construcción del compás.
---

<ambiguous-case class="sim wide">
	<div class="sim-head">
		<h4>Dos costats i un angle no comprès: quants triangles?</h4>
		<p class="muted">B ha de ser a la base i a distància a de C.</p>
	</div>
	<svg class="sim-svg mfig" viewBox="0 0 560 320" role="img" aria-label="Construcció del cas ambigu: costat b des d’A amb l’angle A, i una circumferència de centre C i radi a que talla la base en zero, un o dos punts B."></svg>
	<p class="sim-note"><strong>Nombre de solucions: <output data-out="n"></output>.</strong> <output data-out="why"></output></p>
	<div class="sim-readout"><span><output data-out="sols"></output></span></div>
	<div class="sim-controls">
		<div class="param">
			<label>Angle A: <output data-out="A"></output></label>
			<input type="range" data-k="A" min="10" max="150" step="1" value="35" aria-label="Angle A (graus)" />
		</div>
		<div class="param">
			<label>Costat b: <output data-out="b"></output></label>
			<input type="range" data-k="b" min="3" max="9" step="0.1" value="7" aria-label="Costat b" />
		</div>
		<div class="param">
			<label>Costat a (oposat a A): <output data-out="a"></output></label>
			<input type="range" data-k="a" min="1" max="12" step="0.1" value="5" aria-label="Costat a" />
		</div>
	</div>
</ambiguous-case>

<script>
	import '../../sims/ambiguous-case';
</script>
