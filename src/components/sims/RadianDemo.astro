---
// El radián: arco igual al radio. El arco recorrido se estira sobre una regla a escala.
---

<radian-demo class="sim wide">
	<div class="sim-head">
		<h4>Quants radis mesura l’arc?</h4>
		<p class="muted">El regle de sota és a la mateixa escala que el radi.</p>
	</div>
	<svg class="sim-svg mfig" viewBox="0 0 540 270" role="img" aria-label="Circumferència amb marques a cada radiant i, a sota, l’arc recorregut estirat sobre un regle graduat en radis."></svg>
	<div class="sim-readout">
		<span>Angle: <output data-out="deg"></output></span>
		<span class="r-y">= <output data-out="rad"></output></span>
		<span>≈ <output data-out="dec"></output></span>
	</div>
	<div class="sim-controls">
		<div class="param">
			<label>Angle (graus)</label>
			<input type="range" min="0" max="360" step="0.1" value="57.3" aria-label="Angle en graus" />
		</div>
		<div class="quick" role="group" aria-label="Angles d’exemple">
			<button class="btn btn-sm" type="button" data-go="57.2958">1 rad</button>
			<button class="btn btn-sm" type="button" data-go="90">90°</button>
			<button class="btn btn-sm" type="button" data-go="180">180°</button>
			<button class="btn btn-sm" type="button" data-go="360">360°</button>
		</div>
	</div>
</radian-demo>

<style>
	.quick {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
</style>

<script>
	import '../../sims/radian-demo';
</script>
