---
// El radián: arco igual al radio. El arco recorrido se estira sobre una regla a escala.
---

<radian-demo class="sim wide">
	<div class="sim-head">
		<h4>¿Cuántos radios mide el arco?</h4>
		<p class="muted">La regla de abajo está a la misma escala que el radio.</p>
	</div>
	<svg class="sim-svg mfig" viewBox="0 0 540 270" role="img" aria-label="Circunferencia con marcas cada radián y, debajo, el arco recorrido estirado sobre una regla graduada en radios."></svg>
	<div class="sim-readout">
		<span>Ángulo: <output data-out="deg"></output></span>
		<span class="r-y">= <output data-out="rad"></output></span>
		<span>≈ <output data-out="dec"></output></span>
	</div>
	<div class="sim-controls">
		<div class="param">
			<label>Ángulo (grados)</label>
			<input type="range" min="0" max="360" step="0.1" value="57.3" aria-label="Ángulo en grados" />
		</div>
		<div class="quick" role="group" aria-label="Ángulos de ejemplo">
			<button class="btn btn-sm" type="button" data-go="57.2958">1 rad</button>
			<button class="btn btn-sm" type="button" data-go="90">90°</button>
			<button class="btn btn-sm" type="button" data-go="180">180°</button>
			<button class="btn btn-sm" type="button" data-go="360">360°</button>
		</div>
	</div>
</radian-demo>

<style>
	.quick {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
</style>

<script>
	import '../../sims/radian-demo';
</script>
