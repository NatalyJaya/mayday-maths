---
// Pictograma de cada bloque: resume en un dibujo de qué trata.
interface Props {
	icon: string;
	size?: number;
}
const { icon, size = 56 } = Astro.props;
---

<svg class="glyph" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" data-icon={icon}>
	<rect width="64" height="64" rx="16" class="bg"></rect>
	{
		icon === 'numeros' && (
			<g>
				<path d="M8 40h48" class="axis" />
				{[14, 24, 34, 44, 54].map((x) => <path d={`M${x} 36v8`} class="axis" />)}
				<circle cx="29" cy="40" r="3.2" class="dot" />
				<path d="M24 40 A 5 5 0 0 1 34 40" class="stroke-x" />
				<text x="32" y="25" class="txt" text-anchor="middle">√2</text>
			</g>
		)
	}
	{
		icon === 'algebra' && (
			<g>
				<rect x="12" y="14" width="18" height="18" rx="3" class="fill-x" />
				<rect x="34" y="14" width="18" height="18" rx="3" class="fill" />
				<rect x="12" y="36" width="18" height="14" rx="3" class="fill-y" />
				<path d="M36 43h14M43 36v14" class="stroke" />
			</g>
		)
	}
	{
		icon === 'trigonometria' && (
			<g>
				<circle cx="30" cy="34" r="20" class="stroke-thin" />
				<path d="M30 34 L45.3 21.1" class="stroke" />
				<path d="M45.3 21.1 V34" class="stroke-y" />
				<path d="M30 34 H45.3" class="stroke-x" />
				<path d="M8 34h48M30 10v48" class="axis" />
				<circle cx="45.3" cy="21.1" r="3" class="dot" />
			</g>
		)
	}
	{
		icon === 'geometria' && (
			<g>
				<path d="M10 54V10M10 54h44" class="axis" />
				<path d="M14 48 L50 16" class="stroke" />
				<path d="M18 30h30" class="stroke-x" />
				<circle cx="32" cy="30" r="3" class="dot" />
			</g>
		)
	}
	{
		icon === 'analisis' && (
			<g>
				<path d="M8 50h48M12 54V10" class="axis" />
				<path d="M12 46 C 24 44, 30 14, 52 12" class="stroke" />
				<path d="M20 36 L48 20" class="stroke-g" />
				<circle cx="33" cy="28" r="3" class="dot" />
			</g>
		)
	}
	{
		icon === 'estadistica' && (
			<g>
				<path d="M8 52h48" class="axis" />
				<rect x="13" y="36" width="8" height="16" rx="1.5" class="fill-x" />
				<rect x="24" y="22" width="8" height="30" rx="1.5" class="fill" />
				<rect x="35" y="14" width="8" height="38" rx="1.5" class="fill-y" />
				<rect x="46" y="30" width="8" height="22" rx="1.5" class="fill-x" />
			</g>
		)
	}
</svg>

<style>
	.glyph {
		flex: none;
		display: block;
	}
	.bg {
		fill: var(--surface-2);
	}
	.stroke,
	.stroke-thin,
	.stroke-x,
	.stroke-g,
	.axis,
	.sign {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.stroke {
		stroke: var(--ink);
		stroke-width: 2.6;
	}
	.stroke-thin {
		stroke: var(--ink-2);
		stroke-width: 1.8;
	}
	.stroke-x {
		stroke: var(--q-x);
		stroke-width: 2.6;
	}
	.stroke-y {
		stroke: var(--q-y);
		stroke-width: 2.6;
		fill: none;
		stroke-linecap: round;
	}
	.txt {
		font: 700 15px var(--font-display);
		fill: var(--ink);
	}
	.stroke-g {
		stroke: var(--q-g);
		stroke-width: 2.6;
	}
	.axis {
		stroke: var(--line-strong);
		stroke-width: 1.6;
	}
	.dot {
		fill: var(--q-y);
	}
	.fill {
		fill: var(--ink);
	}
	.fill-x {
		fill: var(--q-x);
	}
	.fill-y {
		fill: var(--q-y);
	}
	.ball {
		fill: var(--q-y);
	}
	.sign {
		stroke: #fff;
		stroke-width: 1.8;
	}
</style>
