---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import { exerciseSlug, exerciseUrl, getSources, getTopic, stageUrl } from '../lib/content';
import { ORIGINS } from '../lib/taxonomy';

const sources = await getSources();
const exercises = await getCollection('ejercicios');
const counts = Object.fromEntries(Object.keys(ORIGINS).map((k) => [k, exercises.filter((e) => e.data.procedencia === k).length]));

const groups = [
	{ tipo: 'clase', id: 'clase', title: 'Apunts de classe', intro: 'La font principal: els apunts i els exercicis treballats a classe. Tots porten l’etiqueta «Exercici de classe».' },
	{ tipo: 'externo', id: 'externos', title: 'Recursos amb llicència oberta', intro: 'Material del qual s’ha adaptat contingut, respectant-ne la llicència i citant-ne l’autoria.' },
	{ tipo: 'referencia', id: 'referencias', title: 'Referències de tipus de problema', intro: 'Col·leccions consultades per identificar els problemes que més es repeteixen i el seu nivell. No es reprodueix cap enunciat: s’utilitzen com a inspiració per crear exercicis originals.' },
	{ tipo: 'curriculo', id: 'curriculo', title: 'Currículum', intro: 'Normativa utilitzada per organitzar el temari.' },
];

const usedBy = async (sourceId: string) => {
	const list = exercises.filter((e) => e.data.fuente === sourceId || e.data.inspirado_en.includes(sourceId));
	return Promise.all(
		list.map(async (e) => {
			const t = await getTopic(e.data.tema);
			return { title: e.data.titulo, href: e.data.rol === 'practica' ? exerciseUrl(t, e) : `${stageUrl(t, 'ejemplos')}#ejemplo-${exerciseSlug(e)}` };
		}),
	);
};
const uses = Object.fromEntries(await Promise.all(sources.map(async (s) => [s.id, await usedBy(s.id)])));
---

<BaseLayout title="Fonts i llicències" description="D’on surt el material de la plataforma i amb quina llicència s’utilitza.">
	<div class="container head">
		<Breadcrumbs items={[{ label: 'Fonts i llicències' }]} />
		<h1>Fonts i llicències</h1>
		<p class="lead">
			Cada exercici indica la seva procedència. N’hi ha tres tipus i es distingeixen amb una etiqueta de color a tot el web.
		</p>
		<ul class="origins">
			{
				Object.entries(ORIGINS).map(([k, o]) => (
					<li>
						<span class:list={['tag', `o-${k}`]}>{o.label}</span>
						<span>
							{o.descripcion} <strong>{counts[k]}</strong> {counts[k] === 1 ? 'exercici' : 'exercicis'}.
						</span>
					</li>
				))
			}
		</ul>
	</div>

	{
		groups.map((g) => {
			const list = sources.filter((s) => s.data.tipo === g.tipo);
			return (
				list.length > 0 && (
					<section class="container group" id={g.id}>
						<h2>{g.title}</h2>
						<p class="muted">{g.intro}</p>
						<div class="cards">
							{list.map((s) => (
								<article class="card src">
									<h3>{s.data.url ? <a href={s.data.url} rel="noopener">{s.data.titulo} <Icon name="external" size={14} /></a> : s.data.titulo}</h3>
									<p class="author">{s.data.autor}</p>
									<dl>
										<div>
											<dt>Llicència</dt>
											<dd>{s.data.licencia_url ? <a href={s.data.licencia_url} rel="license noopener">{s.data.licencia}</a> : s.data.licencia}</dd>
										</div>
										{s.data.consultado && (
											<div>
												<dt>Consultat</dt>
												<dd>{new Date(s.data.consultado).toLocaleDateString('ca-ES', { day: 'numeric', month: 'long', year: 'numeric' })}</dd>
											</div>
										)}
										<div class="full">
											<dt>Com s’utilitza</dt>
											<dd>{s.data.uso}</dd>
										</div>
										{uses[s.id].length > 0 && (
											<div class="full">
												<dt>Exercicis relacionats</dt>
												<dd>
													{uses[s.id].map((u: { title: string; href: string }, i: number) => (
														<>
															{i > 0 && ' · '}
															<a href={u.href}>{u.title}</a>
														</>
													))}
												</dd>
											</div>
										)}
									</dl>
								</article>
							))}
						</div>
					</section>
				)
			);
		})
	}

	<section class="container group">
		<h2>Criteris</h2>
		<ul class="rules">
			<li>Només es reprodueix o s’adapta contingut amb una llicència que ho permet, citant-ne l’autoria, la llicència i els canvis.</li>
			<li>Les adaptacions de recursos CC BY-SA es comparteixen amb la mateixa llicència.</li>
			<li>
				Si un recurs no indica cap llicència, o la seva no permet aquest ús, només se n’analitzen els <em>tipus</em> de problema
				i es creen exercicis originals amb dades i redacció noves.
			</li>
			<li>Tots els resultats numèrics es recalculen automàticament amb el model matemàtic de la plataforma, i cada conjunt de solucions d’una equació es comprova: que totes la compleixen i que no en falta cap.</li>
		</ul>
	</section>
</BaseLayout>

<style>
	.head {
		padding-top: 1.75rem;
	}
	.origins {
		list-style: none;
		padding: 0;
		margin: 1.25rem 0 0;
		display: grid;
		gap: 0.5rem;
	}
	.origins li {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		flex-wrap: wrap;
	}
	.o-clase {
		background: var(--badge-class);
		color: var(--badge-class-ink);
		border-color: transparent;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.74rem;
	}
	.o-original {
		background: var(--accent-soft);
		color: var(--accent);
		border-color: transparent;
	}
	.o-externo {
		background: var(--q-g-soft);
		color: var(--q-g-text);
		border-color: transparent;
	}
	.group {
		margin-top: 3rem;
	}
	.group > p {
		max-width: 70ch;
	}
	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1rem;
		margin-top: 1rem;
	}
	.src {
		padding: 1.15rem 1.25rem;
		border-radius: var(--radius-lg);
	}
	.src h3 {
		font-size: 1.05rem;
		margin-bottom: 0.25rem;
	}
	.src h3 a {
		color: var(--ink);
	}
	.author {
		color: var(--ink-3);
		font-size: 0.92rem;
	}
	dl {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.6rem 1rem;
		margin: 0;
		font-size: 0.93rem;
	}
	dl .full {
		grid-column: 1 / -1;
	}
	dt {
		font: 650 0.74rem var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--ink-3);
	}
	dd {
		margin: 0.1rem 0 0;
		color: var(--ink-2);
	}
	.rules {
		max-width: 75ch;
		display: grid;
		gap: 0.4rem;
	}
	@media (max-width: 420px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
