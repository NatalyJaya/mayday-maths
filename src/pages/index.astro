---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockCard from '../components/syllabus/BlockCard.astro';
import MethodStrip from '../components/syllabus/MethodStrip.astro';
import CircleWave from '../components/sims/CircleWave.astro';
import Icon from '../components/ui/Icon.astro';
import { getBlocks, getTopics } from '../lib/content';
import { withBase } from '../lib/url';

const blocks = await getBlocks();
const topics = await getTopics();
const topicsOf = (id: string) => topics.filter((t) => t.data.bloque.id === id);
const core = blocks.filter((b) => b.data.nivel === 'nucleo');
const extra = blocks.filter((b) => b.data.nivel === 'ampliacion');
---

<BaseLayout>
	<section class="hero">
		<div class="container hero-grid">
			<div class="copy">
				<p class="eyebrow">Matemàtiques I · 1r de Batxillerat</p>
				<h1>Les matemàtiques s’entenen abans de memoritzar-se.</h1>
				<p class="lead">
					Aquí cap fórmula no surt del no-res. Primer veus la idea en un dibuix, després entens d’on surt i
					quan serveix, i al final la fas servir en problemes amb pistes i correcció pas a pas.
				</p>
				<div class="actions">
					<a class="btn btn-primary" href={withBase('/trigonometria/')}>
						Comença per la trigonometria <Icon name="arrow-right" />
					</a>
					<a class="btn" href="#temario">Mostra el temari</a>
				</div>
			</div>
			<div class="instrument card">
				<div class="instrument-head">
					<span class="dot-live" aria-hidden="true"></span>
					<span>La gràfica del sinus és l’<strong>altura d’un punt que gira</strong></span>
				</div>
				<CircleWave bare />
			</div>
		</div>
	</section>

	<section class="section method-section">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Com s’aprèn aquí</p>
				<h2>Sis passos, sempre en el mateix ordre</h2>
				<p class="lead">
					Primer, la intuïció. Després, la formalització. Finalment, els problemes. Tots els temes segueixen el
					mateix recorregut, perquè sempre sàpigues en quin punt ets.
				</p>
			</div>
			<MethodStrip />
		</div>
	</section>

	<section class="section syllabus" id="temario">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Temari</p>
				<h2>El curs de 1r</h2>
				<p class="lead">
					Els sis blocs de Matemàtiques I. Comencem per la trigonometria; la resta de blocs s’aniran obrint.
				</p>
			</div>
			<div class="blocks-core">
				{core.map((b) => <BlockCard block={b} topics={topicsOf(b.id)} />)}
			</div>

			{extra.length > 0 && (<><div class="section-head extra-head">
				<h3>Ampliació segons el teu centre</h3>
				<p class="muted">
					Amb el currículum actual aquests blocs són de 2n, però hi ha centres que n’avancen una part a 1r. Si el teu temari
					els inclou, també els tindràs aquí.
				</p>
			</div>
			<div class="blocks-extra">
				{extra.map((b) => <BlockCard block={b} topics={topicsOf(b.id)} size="sm" />)}
			</div></>)}
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
		align-items: center;
	}
	.copy h1 {
		max-width: 14ch;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.instrument {
		padding: 1rem 1.25rem 1.25rem;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow);
	}
	.instrument-head {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.95rem;
		color: var(--ink-2);
		margin-bottom: 0.75rem;
	}
	.dot-live {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--ok);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 20%, transparent);
	}
	.section-head {
		margin-bottom: 1.75rem;
	}
	.method-section {
		padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
	}
	.blocks-core {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.extra-head {
		margin-top: 3.25rem;
		margin-bottom: 1.25rem;
	}
	.extra-head p {
		max-width: 70ch;
		margin: 0;
	}
	.blocks-extra {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	@media (max-width: 980px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
		.copy h1 {
			max-width: 18ch;
		}
		.blocks-core,
		.blocks-extra {
			grid-template-columns: 1fr;
		}
	}
	@media (min-width: 640px) and (max-width: 980px) {
		.blocks-extra {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
